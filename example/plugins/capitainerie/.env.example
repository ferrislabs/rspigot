# Where the Rspigot server listens for plugins (plugins.yml: host and port).
RSPIGOT_URL=http://127.0.0.1:25580
# Only when plugins.yml sets a token.
# RSPIGOT_TOKEN=

# Capitainerie API.
CAPITAINERIE_URL=http://localhost:4100
# FerrisKey token endpoint of the organization's realm.
CAPITAINERIE_TOKEN_URL=http://localhost:3333/realms/capitainerie/protocol/openid-connect/token
# API audience, sent as the RFC 8707 `resource`. Same value as AUTH_AUDIENCE.
CAPITAINERIE_RESOURCE=http://localhost:4100

# The FerrisKey client of the bridge (public, direct access grants on, listed
# in Capitainerie's AUTH_ACCEPTED_CLIENTS) and the human user it logs in as.
CAPITAINERIE_CLIENT_ID=minecraft
# CAPITAINERIE_CLIENT_SECRET=
CAPITAINERIE_USERNAME=minecraft
CAPITAINERIE_PASSWORD=change-me

# Refresh interval, 1 to 60 seconds.
CAPITAINERIE_POLL_SECONDS=2
